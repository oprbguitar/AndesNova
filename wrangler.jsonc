{
  // AndesNova on Cloudflare Workers (free plan): static site + /api/chat.
  // Deploy with: npm run deploy:cf
  "name": "andesnova-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_QUOTA",
      "id": "9cfb88557cf54f48b25bc71e30ffdea4"
    }
  ],
  "vars": {
    "DAILY_AI_LIMIT": "56",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": {
    "enabled": true
  }
}
